{
  "name": "@orbisk/vue-use-barcode-detection",
  "version": "0.5.0",
  "description": "Vue composable wrapping Barcode Detection API",
  "keywords": [
    "barcode",
    "barcode-detection",
    "composables",
    "qr",
    "qr-code",
    "scanner",
    "vue",
    "vueuse",
    "webcam"
  ],
  "homepage": "https://github.com/OrbisK/vue-use-barcode-detection#readme",
  "bugs": {
    "url": "https://github.com/OrbisK/vue-use-barcode-detection/issues"
  },
  "license": "MIT",
  "author": "OrbisK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrbisK/vue-use-barcode-detection.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "play": "vp dev",
    "check": "vp check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt --write",
    "fmt:check": "vp fmt --check",
    "test": "vp test watch",
    "test:run": "vp test",
    "test:types": "vue-tsc --noEmit && vp run -F @orbisk/nuxt-barcode-detection test:types",
    "coverage": "vp test --coverage",
    "docs:dev": "pnpm -F docs dev",
    "docs:build": "pnpm -F docs build",
    "docs:generate": "vp pack && pnpm -F docs generate",
    "docs:preview": "pnpm -F docs preview",
    "release": "bumpp",
    "prepare": "vp config",
    "dev:prepare": "pnpm -F @orbisk/nuxt-barcode-detection dev:prepare",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/server-renderer": "^3.5.33",
    "@vue/test-utils": "^2.4.9",
    "@vueuse/core": "^14.2.1",
    "bumpp": "^11.0.1",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20",
    "vitest": "^4.1.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.2.7"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.0.0",
    "vue": "^3.5.0"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}
