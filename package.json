{
  "name": "@orbiks/vueuse-barcode-detection",
  "version": "0.1.0",
  "description": "Vue composable wrapping Barcode Detection API",
  "keywords": [
    "barcode",
    "barcode-detection",
    "composables",
    "qr",
    "qr-code",
    "scanner",
    "vue",
    "vueuse",
    "webcam"
  ],
  "homepage": "https://github.com/orbisk/vueuse-barcode-detection#readme",
  "bugs": {
    "url": "https://github.com/orbisk/vueuse-barcode-detection/issues"
  },
  "license": "MIT",
  "author": "orbisk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbisk/vueuse-barcode-detection.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp dev playground",
    "play": "vp dev playground",
    "check": "vp check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt --write",
    "fmt:check": "vp fmt --check",
    "test": "vp test watch",
    "test:run": "vp test",
    "test:types": "vue-tsc --noEmit",
    "coverage": "vp test --coverage",
    "docs:dev": "pnpm -F docs dev",
    "docs:build": "pnpm -F docs build",
    "docs:generate": "pnpm -F docs generate",
    "docs:preview": "pnpm -F docs preview",
    "release": "bumpp && pnpm publish",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.9",
    "@vueuse/core": "^14.2.1",
    "bumpp": "^11.0.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vite-plus": "^0.1.20",
    "vitest": "^4.1.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.2.7"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.0.0",
    "vue": "^3.5.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec vp staged"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
