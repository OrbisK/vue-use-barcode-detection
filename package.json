{
  "name": "@orbisk/vue-use-barcode-detection",
  "version": "0.1.4",
  "description": "Vue composable wrapping Barcode Detection API",
  "keywords": [
    "barcode",
    "barcode-detection",
    "composables",
    "qr",
    "qr-code",
    "scanner",
    "vue",
    "vueuse",
    "webcam"
  ],
  "homepage": "https://github.com/OrbisK/vue-use-barcode-detection#readme",
  "bugs": {
    "url": "https://github.com/OrbisK/vue-use-barcode-detection/issues"
  },
  "license": "MIT",
  "author": "OrbisK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrbisK/vue-use-barcode-detection.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.mts",
      "default": "./dist/nuxt.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "play": "vp dev",
    "check": "vp check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt --write",
    "fmt:check": "vp fmt --check",
    "test": "vp test watch",
    "test:run": "vp test",
    "test:types": "vue-tsc --noEmit",
    "coverage": "vp test --coverage",
    "docs:dev": "pnpm -F docs dev",
    "docs:build": "pnpm -F docs build",
    "docs:generate": "vp pack && pnpm -F docs generate",
    "docs:preview": "pnpm -F docs preview",
    "release": "bumpp && pnpm publish",
    "prepare": "vp config",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.0.0",
    "@nuxt/ui": "^4.7.1",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/server-renderer": "^3.5.33",
    "@vue/test-utils": "^2.4.9",
    "@vueuse/core": "^14.2.1",
    "bumpp": "^11.0.1",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20",
    "vitest": "^4.1.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.2.7"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.0.0",
    "@vueuse/core": "^14.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/ui": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.0.5+sha512.94fa09e72016402aefce788e46994e18eb1922998b16b6fd5aa6bafd8ae4dea05d0852f60247fdb7d5ab8199a7b0beda830398f3f80cb9f822398522a1535481"
}
