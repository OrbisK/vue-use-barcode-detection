{
  "name": "@orbisk/nuxt-barcode-detection",
  "version": "0.4.0",
  "description": "Nuxt module for @orbisk/vue-use-barcode-detection (auto-imports, components, polyfill plugin)",
  "keywords": [
    "barcode",
    "barcode-detection",
    "nuxt",
    "nuxt-module",
    "qr",
    "scanner",
    "vue"
  ],
  "homepage": "https://github.com/OrbisK/vue-use-barcode-detection#readme",
  "bugs": {
    "url": "https://github.com/OrbisK/vue-use-barcode-detection/issues"
  },
  "license": "MIT",
  "author": "OrbisK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrbisK/vue-use-barcode-detection.git",
    "directory": "packages/nuxt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "prepack": "nuxt-module-build prepare && nuxt-module-build build",
    "dev:prepare": "nuxt-module-build prepare && nuxt-module-build build --stub",
    "test:types": "nuxt-module-build prepare && vue-tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@nuxt/kit": "^4.0.0",
    "consola": "^3.4.0",
    "exsolve": "^1.0.0",
    "magicast": "^0.5.0",
    "nypm": "^0.6.0",
    "pathe": "^2.0.0",
    "std-env": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.0.0",
    "@nuxt/ui": "^4.7.1",
    "@orbisk/vue-use-barcode-detection": "workspace:*",
    "@vueuse/core": "^14.2.1",
    "nuxt": "^4.0.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.0",
    "vue-tsc": "^3.2.7"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.0.0",
    "@orbisk/vue-use-barcode-detection": "^0.2.0",
    "barcode-detector": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/ui": {
      "optional": true
    },
    "barcode-detector": {
      "optional": true
    }
  }
}
